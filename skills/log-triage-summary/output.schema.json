{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Active canonical LogAnalysisResult contract. The semantic runtime groups annotated evidence_entry_ids; the worker then expands equivalent evidence, retains physical-record counts for complete coverage, and exposes correlated occurrence counts separately. Chinese and English are presentations of the same finding object. Historical snapshots may retain the legacy cause/action fields under their frozen schema.",
  "type": "object",
  "properties": {
    "total_entries": {"type": "integer", "minimum": 0},
    "summary_en": {"type": "string", "minLength": 1, "maxLength": 800},
    "summary_zh": {"type": "string", "minLength": 1, "maxLength": 800},
    "key_finds": {
      "type": "array",
      "items": {"$ref": "#/$defs/key_find"},
      "minItems": 1
    },
    "secondary_finds": {
      "type": "array",
      "items": {"$ref": "#/$defs/secondary_find"}
    },
    "severity_signal": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
  },
  "required": [
    "total_entries", "summary_en", "summary_zh", "key_finds", "secondary_finds",
    "severity_signal", "confidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "find": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label_en": {"type": "string", "minLength": 1},
        "label_zh": {"type": "string", "minLength": 1},
        "count": {"type": ["integer", "null"], "minimum": 0},
        "percentage": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "physical_entry_count": {"type": "integer", "minimum": 0},
        "occurrence_count": {"type": "integer", "minimum": 0},
        "pattern_ids": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_entry_ids": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0},
          "minItems": 1,
          "uniqueItems": true
        },
        "detail_en": {"type": "string", "minLength": 1},
        "detail_zh": {"type": "string", "minLength": 1}
      },
      "required": ["id", "label_en", "label_zh", "count", "percentage", "pattern_ids", "detail_en", "detail_zh"],
      "additionalProperties": false
    },
    "key_find": {
      "allOf": [
        {"$ref": "#/$defs/find"},
        {"properties": {
          "detail_en": {"maxLength": 600},
          "detail_zh": {"maxLength": 600}
        }}
      ]
    },
    "secondary_find": {
      "allOf": [
        {"$ref": "#/$defs/find"},
        {"properties": {
          "detail_en": {"maxLength": 320},
          "detail_zh": {"maxLength": 320}
        }}
      ]
    }
  }
}
