{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Narrative-only ReportPlan. Coverage, evidence, numbering, ordering, and analysis completeness are owned by deterministic Report Composition.",
  "type": "object",
  "required": ["general_summary"],
  "additionalProperties": false,
  "properties": {
    "general_summary": {"$ref": "#/$defs/bilingual_summary"},
    "cross_incident_findings": {"$ref": "#/$defs/bilingual_summary"}
  },
  "$defs": {
    "bilingual_summary": {
      "type": "object",
      "required": ["zh", "en"],
      "additionalProperties": false,
      "properties": {
        "zh": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    }
  }
}
