# Host-side Claude Bridge service (master plan §27). Install:
#
#   sudo cp infrastructure/systemd/noc-claude-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now noc-claude-bridge
#
# The bridge is the only component authorized to spawn job containers, so
# it runs as a normal (non-root) user who is a member of the `docker`
# group — never as root itself.
[Unit]
Description=NOC Report Builder — Claude Bridge (RabbitMQ job consumer, Docker sandbox runner)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=noc-bridge
Group=docker
WorkingDirectory=/opt/noc-report/bridge
Environment=PYTHONUNBUFFERED=1
# Bridge-specific overrides read via BRIDGE_ env prefix (see
# noc_bridge/config.py) — keep real secrets in this file, not in git.
EnvironmentFile=-/etc/noc-report/bridge.env
ExecStart=/usr/bin/python3 -m noc_bridge
Restart=on-failure
RestartSec=5
# Same posture as the sandbox containers it spawns: least privilege for
# the service itself, even though it isn't containerized.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
